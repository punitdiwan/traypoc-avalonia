DATABASE_URL=postgres://postgres:password@localhost:5432/timetracker?sslmode=disable
REDIS_URL=localhost:6379
JWT_SECRET=change-me-in-production-use-32-chars-min
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Billing currency (ISO 4217 code) for rates/invoices. Defaults to INR.
CURRENCY=INR
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=time-tracker-screenshots
DO_SPACES_REGION=nyc3

# Weekly email reports (uses net/smtp — works with Gmail, SendGrid SMTP relay, SES SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Time Tracker <you@gmail.com>

# Shown in report emails as "View full diary" link
DASHBOARD_URL=http://localhost:5173

# Seed accounts — inserted on first startup if the email doesn't already exist.
# Safe to leave as-is for local dev; change before deploying to production.
SEED_EMPLOYER_EMAIL=admin@example.com
SEED_EMPLOYER_PASSWORD=Admin1234!
SEED_EMPLOYEE_EMAIL=employee@example.com
SEED_EMPLOYEE_PASSWORD=Employee1234!

# ── LiveKit SFU (voice calls + recording) ─────────────────────────────────────
# When LIVEKIT_URL/KEY/SECRET are all set, calls run over a LiveKit room (the SFU
# relays media — no TURN hunt, works on strict/symmetric NAT) and the legacy P2P
# mesh + Pion recorder bot below are bypassed. URL is the public wss endpoint the
# browser connects to; KEY/SECRET must match the livekit-server config (see
# docker/livekit/). Generate a key/secret pair with: `openssl rand -hex 16` each.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Set to 1 to record calls server-side via LiveKit Egress → DO Spaces (needs the
# egress service in docker/livekit/ running, plus DO_SPACES_* below).
LIVEKIT_RECORD=

# ── Voice calls / chat (legacy P2P mesh — used only when LIVEKIT_* is unset) ───
# STUN is used for NAT discovery (a public server is the default if unset).
STUN_URL=stun:stun.l.google.com:19302
# TURN relays media when a direct P2P connection fails — REQUIRED for calls on
# mobile/strict networks. Point TURN_HOST at a coturn server and share its
# static-auth-secret. Multiple transports may be comma-separated, e.g.
# "turn:turn.example.com:3478,turns:turn.example.com:5349".
TURN_HOST=
TURN_SECRET=

# ── Web Push (incoming-call ringing on a closed PWA) ──────────────────────────
# Generate a VAPID keypair once (e.g. `npx web-push generate-vapid-keys`).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
