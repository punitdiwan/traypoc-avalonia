# Build the React/Vite SPA, then serve the static bundle with a small nginx.
# Build context is the repo root (see docker-compose.yml: context: ..).
FROM node:24-alpine AS builder
RUN corepack enable
WORKDIR /repo

# Workspace manifests first so `pnpm install` caches independently of source.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --filter @time-tracker/web... --frozen-lockfile

# Source + production build (tsc + vite). No build-time API URL is needed:
# the bundle talks to a same-origin /api and /ws, which the host nginx proxies.
COPY apps/web apps/web
RUN pnpm --filter @time-tracker/web build

FROM nginx:1.27-alpine
COPY docker/web-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 80
