<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    TrayPoc MSI definition (WiX v5).
    Preprocessor variables (supplied by the .wixproj / CI):
      $(var.PublishDir)  - folder containing the published win-x64 app
      $(var.IconFile)    - path to the .ico used for ARP + shortcuts
      $(var.Version)     - product version (e.g. 1.0.0)
  -->
  <Package Name="TrayPoc"
           Manufacturer="TrayPoc"
           Version="$(var.Version)"
           UpgradeCode="6f3d2a4e-1b7c-4f2a-9c10-2a7b5e9d4c01"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs metadata. Repair is intentionally left enabled
         (no ARPNOREPAIR), so ARP shows Modify / Repair / Uninstall and the
         MSI's own maintenance wizard exposes the Repair option. -->
    <Icon Id="TrayPocIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="TrayPocIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/" />

    <!-- Full setup wizard (Welcome -> License -> Install dir -> Progress ->
         Finish) plus the maintenance wizard with Change / Repair / Remove. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!-- Offer to launch the tray app straight from the Finish page. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch TrayPoc now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[INSTALLFOLDER]TrayPoc.exe" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!-- Install location: C:\Program Files\TrayPoc -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TrayPoc" />
    </StandardDirectory>

    <!-- Start menu folder -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuDir" Name="TrayPoc" />
    </StandardDirectory>

    <!-- Desktop (for the desktop shortcut) -->
    <StandardDirectory Id="DesktopFolder" />

    <!-- Harvest every published file into Program Files\TrayPoc -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <!-- Bitness comes from the package arch (InstallerPlatform=x64 in the .wixproj). -->
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <!-- Start-menu shortcut to the app -->
    <Component Id="StartMenuShortcut" Directory="AppProgramMenuDir" Guid="7a1c9b22-3e44-4d6f-8b21-9f0c4e7d5a02" Bitness="always64">
      <Shortcut Id="TrayPocStartMenu"
                Name="TrayPoc"
                Description="Avalonia cross-platform tray POC"
                Target="[INSTALLFOLDER]TrayPoc.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="TrayPocIcon" />
      <RemoveFolder Id="RemoveAppProgramMenuDir" Directory="AppProgramMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\TrayPoc" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="3c5f7a91-8d22-4e63-9a04-1b7e6c2d9f03" Bitness="always64">
      <Shortcut Id="TrayPocDesktop"
                Name="TrayPoc"
                Description="Avalonia cross-platform tray POC"
                Target="[INSTALLFOLDER]TrayPoc.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="TrayPocIcon" />
      <RegistryValue Root="HKCU" Key="Software\TrayPoc" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Optional: launch at Windows logon (current user). A tray app usually wants this. -->
    <Component Id="RunAtStartup" Directory="INSTALLFOLDER" Guid="2d8e6c14-5a09-4b7e-9d33-c1b6f4e8a703" Bitness="always64">
      <RegistryValue Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="TrayPoc"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]TrayPoc.exe&quot;"
                     KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="TrayPoc" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Run-at-startup is a separate, optional feature -->
    <Feature Id="StartupEntry" Title="Start TrayPoc at logon" Level="1">
      <ComponentRef Id="RunAtStartup" />
    </Feature>

  </Package>
</Wix>
