<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>TrayPoc-$(ProductVersion)-win-x64</OutputName>
    <OutputType>Package</OutputType>

    <!-- Build a 64-bit MSI (passes -arch x64 to WiX). Matches the win-x64 app
         and makes harvested components default to 64-bit (avoids ICE80). -->
    <InstallerPlatform>x64</InstallerPlatform>

    <!-- Version embedded in the MSI; override with -p:ProductVersion=x.y.z -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.1.0</ProductVersion>

    <!--
      Folder holding the published win-x64 app. Defaults to <repo>/publish/win-x64.
      CI overrides this with -p:PublishDir=...
    -->
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\publish\win-x64\</PublishDir>
    <IconFile Condition="'$(IconFile)' == ''">$(MSBuildThisFileDirectory)..\..\..\apps\desktop\Assets\tray-icon.ico</IconFile>
  </PropertyGroup>

  <!-- Expose the MSBuild properties to the WiX preprocessor as $(var.*) -->
  <ItemGroup>
    <BindPath Include="$(PublishDir)" />
  </ItemGroup>

  <PropertyGroup>
    <DefineConstants>PublishDir=$(PublishDir);IconFile=$(IconFile);Version=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <!-- WixUI_InstallDir wizard dialogs + the WixShellExec custom action used to
       launch the app from the Finish page. -->
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <!-- License text shown on the LicenseAgreementDlg. -->
  <ItemGroup>
    <WixVariable Include="WixUILicenseRtf" Value="$(MSBuildThisFileDirectory)License.rtf" />
  </ItemGroup>

</Project>
