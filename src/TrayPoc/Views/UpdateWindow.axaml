<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="170"
        x:Class="TrayPoc.Views.UpdateWindow"
        Icon="/Assets/tray-icon.ico"
        Title="Updating TrayPoc"
        Width="400" Height="170"
        CanResize="False"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">

    <Border Padding="24">
        <StackPanel Spacing="16" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Image Source="/Assets/tray-icon-128.png" Width="40" Height="40"/>
                <TextBlock x:Name="StatusText"
                           Text="Checking for updates…"
                           VerticalAlignment="Center"
                           FontSize="15"/>
            </StackPanel>

            <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" Height="6"/>

            <TextBlock x:Name="DetailText"
                       Foreground="#888" FontSize="12"
                       Text="Downloading…"/>
        </StackPanel>
    </Border>
</Window>
